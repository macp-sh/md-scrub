{
  "name": "third-party licensing content",
  "description": "Test fixture: licence names, licence terms, copyright notices and terms of service. Broad on purpose so the pipeline tests are deterministic without Jev.",
  "notIncluded": "Installing packages, pricing, licence keys, professional licences.",
  "message": "Test fixture rule: no licensing content in Markdown.",
  "examples": { "is": ["This package is licensed under MIT."], "isNot": ["Install with bun add stripe."] },
  "mostly": { "description": "Most of the text is licensing or terms content.", "is": ["A terms of service page."], "isNot": ["A setup guide."] },
  "keywords": [
    { "label": "licensed under", "pattern": "\\blicen[cs]ed under\\b", "flags": "i" },
    { "label": "licence name", "pattern": "\\b(MIT|Apache|BSD|ISC|GNU|Mozilla|Eclipse|Boost|Unlicense|Open Font|SIL|Unsplash|Pexels)\\s+(Public\\s+)?Licen[cs]e\\b", "flags": "i" },
    { "label": "SPDX identifier", "pattern": "\\b(SPDX-License-Identifier|Apache-2\\.0|[AL]?GPL-[23]\\.\\d(-only|-or-later)?|MPL-2\\.0|BSD-[234]-Clause|EPL-[12]\\.0|OFL-1\\.1|ODbL-1\\.0|CC0-1\\.0|CC-BY(-SA|-NC|-ND)*-\\d\\.\\d)\\b" },
    { "label": "licence type", "pattern": "\\b([AL]?GPL(v?[23])?|MPL|EUPL|WTFPL|Unlicense|CC0|copyleft|share-?alike)\\b", "flags": "i" },
    { "label": "licence type", "pattern": "\\b(MIT|BSD|ISC|Apache|Mozilla|Eclipse|Boost|Zlib|Artistic|permissive|proprietary)[- ](\\d-clause[- ])?licen[cs](e|ed)\\b", "flags": "i" },
    { "label": "licence type", "pattern": "\\((MIT|BSD|ISC|Apache(\\s?2(\\.0)?)?|0BSD)\\)|\\|\\s*(MIT|BSD|ISC|Apache(\\s?2(\\.0)?)?|0BSD)\\s*\\|" },
    { "label": "Creative Commons", "pattern": "\\b(creative commons|CC BY(-SA|-NC|-ND)*( \\d\\.\\d)?)\\b", "flags": "i" },
    { "label": "licence badge", "pattern": "shields\\.io\\/[^\\s)]*licen[cs]e", "flags": "i" },
    { "label": "copyright notice", "pattern": "(©|\\bcopyright\\s+(\\(c\\)|©|\\d{4}))", "flags": "i" },
    { "label": "terms of service", "pattern": "\\bterms of (service|use)\\b", "flags": "i" },
    { "label": "acceptable use policy", "pattern": "\\bacceptable use polic(y|ies)\\b", "flags": "i" },
    { "label": "EULA", "pattern": "\\b(EULA|end[- ]user licen[cs]e agreement)\\b", "flags": "i" },
    { "label": "non-commercial use", "pattern": "\\bnon-?commercial use\\b", "flags": "i" }
  ]
}
